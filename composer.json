{
    "name": "mdrisss/bookstack-files",
    "description": "Fichiers liés (PDF, documents, schémas...) pour les étagères, livres, chapitres et pages BookStack, avec aperçu en popup et traçabilité dans le journal d'audit.",
    "type": "library",
    "license": "MIT",
    "keywords": ["bookstack", "laravel", "attachments", "pdf"],
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Mdrisss\\BookstackFiles\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mdrisss\\BookstackFiles\\BookstackFilesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
